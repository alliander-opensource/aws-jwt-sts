{
  "name": "@alliander-opensource/aws-jwt-sts",
  "license": "Apache-2.0",
  "version": "0.4.0",
  "author": {
    "name": "Alliander NV"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alliander-opensource/aws-jwt-sts.git"
  },
  "packageManager": "pnpm@11.25.0",
  "main": "dist/index.js",
  "files": [
    "dist/*",
    ".jsii"
  ],
  "types": "dist/index.d.ts",
  "keywords": [
    "awscdk"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "jsii": {
    "tsc": {
      "rootDir": "src",
      "outDir": "dist"
    },
    "outdir": "jsii",
    "versionFormat": "full",
    "targets": {
      "python": {
        "distName": "alliander-opensource-aws-jwt-sts",
        "module": "alliander_opensource.aws_jwt_sts"
      }
    }
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "./build.sh",
    "watch": "tsc -w",
    "test": "jest --coverage",
    "cdk": "cdk",
    "lint": "oxlint --deny-warnings ."
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1146.1",
    "aws-cdk-lib": "2.274.0",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-jest": "^4.1.0",
    "constructs": "10.8.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "jsii": "~6.0.18",
    "jwt-decode": "^4.0.0",
    "oxlint": "^1.89.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.268.0",
    "constructs": "^10.6.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-kms": "^3.1125.0",
    "@aws-sdk/client-s3": "^3.1125.0",
    "@types/aws-lambda": "^8.10.163",
    "@types/jsrsasign": "^10.5.15",
    "base64url": "^3.0.1",
    "jsrsasign": "^11.1.5"
  },
  "bundleDependencies": [
    "@aws-lambda-powertools/logger",
    "@aws-sdk/client-kms",
    "@aws-sdk/client-s3",
    "@types/aws-lambda",
    "@types/jsrsasign",
    "base64url",
    "jsrsasign"
  ]
}
